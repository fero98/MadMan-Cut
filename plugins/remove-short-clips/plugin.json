{
  "nuzkyPlugin": 1,
  "id": "remove-short-clips",
  "name": "Odstranit krátké klipy",
  "description": "Vyhledá a odstraní klipy kratší než zvolená délka. Střih lze vrátit zpět.",
  "version": "1.0.0",
  "action": "Odstranit klipy",
  "inputs": [
    {
      "type": "number",
      "id": "minSeconds",
      "label": "Kratší než",
      "min": 0.1,
      "max": 10,
      "step": 0.1,
      "default": 1,
      "unit": "s"
    },
    {
      "type": "choice",
      "id": "tracks",
      "label": "Stopy",
      "options": [
        {
          "value": "main",
          "label": "Hlavní stopa"
        },
        {
          "value": "all",
          "label": "Všechny stopy"
        }
      ],
      "default": "main"
    }
  ]
}
