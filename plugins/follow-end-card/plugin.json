{
  "nuzkyPlugin": 1,
  "id": "follow-end-card",
  "name": "Závěrečná výzva",
  "description": "Přidá vlastní text do závěru videa, například výzvu ke sledování.",
  "version": "1.0.0",
  "action": "Přidat text",
  "inputs": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Sledujte pro další videa"
    },
    {
      "type": "number",
      "id": "seconds",
      "label": "Poslední",
      "min": 1,
      "max": 10,
      "step": 0.5,
      "default": 3,
      "unit": "s"
    },
    {
      "type": "color",
      "id": "color",
      "label": "Barva",
      "default": "#FFFFFF"
    },
    {
      "type": "toggle",
      "id": "bold",
      "label": "Tučně",
      "default": true
    }
  ]
}
